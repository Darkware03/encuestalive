# =============================================================================
# EncuestaLive — plantilla del fichero de entorno de Docker Compose
# =============================================================================
#
#   Cópiese a `.env.docker` EN EL SERVIDOR y rellénese allí:
#
#       cp docker/env.docker.example .env.docker
#       chmod 600 .env.docker
#       docker compose --env-file .env.docker up -d
#
#   `.env.docker` NO se versiona (está cubierto por `.env.*` en .gitignore).
#   Este fichero de ejemplo NO contiene ni una sola credencial real: todos los
#   huecos están vacíos a propósito. Si alguna vez ves un valor que parece una
#   contraseña aquí dentro, es un error y hay que rotarla.
#
#   *** NO VERIFICADO: no se ha podido ejecutar `docker compose` en el host de
#       la fábrica, así que esta plantilla no se ha probado contra Compose. ***
#
# -----------------------------------------------------------------------------
# Las variables SIN valor por defecto en docker-compose.yml usan la sintaxis
# `${VAR:?mensaje}`. Si falta alguna, Compose ABORTA con ese mensaje en lugar
# de arrancar con un valor inventado. Es deliberado: prefiero que no arranque
# a que arranque mal.
# -----------------------------------------------------------------------------


# === Identidad y versión =====================================================
APP_NAME=EncuestaLive
ENCUESTALIVE_TAG=1.0.0

# === Entorno (lista de comprobación de producción, F-09) =====================
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# Generar UNA sola vez y conservarla:
#     php artisan key:generate --show
# Si cambia, TODAS las cookies firmadas quedan inválidas, incluido el token
# opaco de participante (ADR-0005) que impide las respuestas duplicadas.
APP_KEY=

# El origen EXACTO por el que se sirve, con esquema y sin barra final.
# Debe coincidir con lo que escribe el navegador: la CSP `default-src 'self'`
# trata `https://encuestas.example.sv` y `https://www.encuestas.example.sv`
# como orígenes distintos.
APP_URL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# === Publicación local =======================================================
# El TLS lo termina un proxy POR DELANTE. Este puerto se publica solo en
# loopback; cambiar HTTP_BIND a 0.0.0.0 expondría la aplicación por HTTP plano
# con las cookies de sesión en claro.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Si hay TLS delante (y debe haberlo), déjese en true.
SESSION_SECURE_COOKIE=true

# === Base de datos (D-04: MySQL 8) ===========================================
MYSQL_DATABASE=encuestalive
MYSQL_USER=encuestalive
# Generar con:  openssl rand -base64 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# === Tiempo real (D-02, F-07) ================================================
REVERB_APP_ID=encuestalive
# PÚBLICA por diseño: viaja en el bundle JS. No es un secreto.
REVERB_APP_KEY=
# SECRETO. Generar con:  openssl rand -hex 32
# Nunca con prefijo VITE_, nunca en el repositorio, nunca en un log.
REVERB_APP_SECRET=

# -----------------------------------------------------------------------------
# PUBLIC_REVERB_* — lo que verá el NAVEGADOR, no el servidor.
# -----------------------------------------------------------------------------
# Se hornean en el bundle JavaScript durante `docker compose build`
# (`import.meta.env.VITE_REVERB_*` en resources/js/realtime.js). Cambiar estos
# valores EXIGE reconstruir la imagen: no basta con reiniciar.
#
# Como nginx publica Reverb bajo `/app`, aquí va el host y el puerto PÚBLICOS
# de la aplicación, no los del contenedor.
PUBLIC_REVERB_HOST=
PUBLIC_REVERB_PORT=443
PUBLIC_REVERB_SCHEME=https

# === Retención (D-12) ========================================================
# [SUPUESTO — requiere validación legal] Nadie del equipo ha validado la
# normativa salvadoreña. 30 días es el plazo más corto y defendible.
# El valor que se ponga aquí es el que la página pública de privacidad le
# PROMETE al participante: si se sube, hay que poder cumplirlo.
SECURITY_LOG_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=30
