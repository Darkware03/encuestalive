APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Base de datos (D-04 / ADR-0003)
# ----------------------------------------------------------------------------
# SQLite en DESARROLLO (es el unico motor viable en el host de la fabrica) y
# MySQL 8 como DESTINO DECLARADO de despliegue.
#
# Los tres PRAGMA de SQLite (foreign_keys=ON, WAL, busy_timeout) se aplican en
# config/database.php, en el conector, no aqui. No hace falta tocar nada.
DB_CONNECTION=sqlite

# --- Para desplegar contra MySQL 8 (Fase 8) ---------------------------------
# Descomentar este bloque Y cambiar DB_CONNECTION a `mysql`.
#
# AVISO QUE CUESTA CARO APRENDER (hallazgo F-05): SQLite NO aplica las
# longitudes de VARCHAR y MySQL 8 en modo estricto SI. Un titulo de 5000
# caracteres entra sin protestar en SQLite y REVIENTA en MySQL. La validacion
# en PHP (config/encuestalive.php -> limits) es la unica barrera real en
# desarrollo. Antes de dar por bueno un despliegue, pasa la suite contra MySQL:
# el trabajo `tests-mysql` de .github/workflows/ci.yml existe para eso.
#
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=encuestalive
# DB_USERNAME=encuestalive
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# D-11 / F-H1: `file`, NUNCA `database`.
# Con `database`, la tabla `sessions` del framework guardaria ip_address y
# user_agent de TODO visitante, participantes anonimos incluidos: un segundo
# almacen de IP que contradice el brief 5.2. Desde la Fase 7b esas columnas ya
# no existen en el esquema y AppServiceProvider avisa si se configura.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# F-09: sin definir, evalua a null y la cookie de sesion sale SIN `Secure`.
# Correcto en local sobre HTTP; en produccion debe ser true (ver el bloque
# "LISTA DE COMPROBACION DE PRODUCCION" al final de este fichero).
SESSION_SECURE_COOKIE=false

# BROADCAST_CONNECTION se declara una sola vez, mas abajo, en el bloque de
# EncuestaLive. Estaba duplicado aqui y en la linea 78, las dos veces con el
# valor inseguro `log` (hallazgo F-07).
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# EncuestaLive — Fase 5b
# ----------------------------------------------------------------------------

# Tiempo real (D-02, ADR-0002).
# Reverb es el PRIMARIO. El respaldo wire:poll de 5 s NO es opcional: es lo que
# garantiza CA-08 si Reverb no arranca en el entorno de destino.
#
# =======================================================================
#  NO PONGAS AQUI `log` NI `null`. HALLAZGO F-07 (ALTO).
# =======================================================================
# Esta variable traia `log`, y eso NO significaba "tiempo real desactivado":
# significaba AUTORIZACION DE CANAL DESACTIVADA. `LogBroadcaster::auth()` y
# `NullBroadcaster::auth()` tienen el cuerpo vacio, asi que el callback de
# routes/channels.php (que aplica SurveyPolicy::view sobre la encuesta
# concreta) NUNCA se ejecutaba y se autorizaba a cualquiera, anonimo incluido.
# Verificado por el auditor contra los tres difusores en la Fase 7.
#
# No hace falta `log` para desarrollar sin Reverb: con `reverb` configurado y
# el servidor APAGADO, SafeBroadcaster captura el fallo de transporte, lo
# registra como `broadcast_failed` y el dashboard degrada al sondeo de 5 s,
# que es el comportamiento que D-02 exige. La autorizacion sigue activa.
#
# Para el tiempo real completo: `php artisan reverb:start`.
# AppServiceProvider avisa si se configura un difusor sin autorizacion, y en
# produccion se NIEGA a arrancar.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=encuestalive
REVERB_APP_KEY=encuestalive-local-key
# NUNCA con prefijo VITE_: este secreto no debe acabar en el bundle de JS.
REVERB_APP_SECRET=cambia-esto-en-despliegue
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# VITE_REVERB_APP_KEY es PUBLICA por diseno: viaja en el bundle JS. No es un
# secreto. La seguridad del canal privado la aporta /broadcasting/auth, que
# aplica SurveyPolicy::view sobre la encuesta concreta (CA-12).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================================================
#  TRAMPA DE DESPLIEGUE: las VITE_* NO se leen en tiempo de ejecucion
# ============================================================================
# Vite las SUSTITUYE LITERALMENTE dentro del bundle JavaScript durante
# `npm run build` (resources/js/realtime.js:46-63 lee `import.meta.env.*`).
#
# Consecuencia: cambiar VITE_REVERB_HOST en el .env del servidor NO TIENE
# NINGUN EFECTO si no se vuelve a compilar. Si se construyen los assets con
# los valores locales (127.0.0.1:8080) y se despliegan en un dominio real, el
# navegador del administrador abrira el WebSocket contra SU PROPIO 127.0.0.1.
# No habra ningun error en el servidor: el dashboard se quedara en el sondeo
# de 15 s y parecera que "el tiempo real va lento".
#
# Regla: tras cambiar cualquier VITE_*, SIEMPRE `npm run build`.
# En Docker son argumentos de construccion (ver Dockerfile, etapa `assets`).

# Presencia (D-12): 20 s de renovacion, 60 s de expiracion.
PRESENCE_HEARTBEAT_SECONDS=20
PRESENCE_EXPIRY_SECONDS=60

# Retencion (D-12). [SUPUESTO — requiere validacion legal]
SECURITY_LOG_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=30

# Vigencia de la cookie opaca de participante (ADR-0005), en minutos.
PARTICIPANT_TOKEN_TTL_MINUTES=1440

# AVISO (aprendido en la verificacion visual de la Fase 5b):
# APP_URL debe coincidir con el host por el que se sirve la aplicacion.
# La CSP de SecurityHeaders aplica `default-src 'self'` y `form-action 'self'`,
# asi que si APP_URL dice "localhost" y se navega por "127.0.0.1" (o al reves),
# el navegador los trata como ORIGENES DISTINTOS y bloquea el CSS, el JS y el
# envio del formulario publico. La pagina se ve rota sin ningun error en el
# servidor. Ver AppServiceProvider: no se usa URL::forceRootUrl por este motivo.

# ============================================================================
# LISTA DE COMPROBACION DE PRODUCCION (F-09, F-07, F-11 — Fase 7b)
# ============================================================================
# Esta plantilla esta afinada para DESARROLLO LOCAL. Es tambien el fichero
# desde el que se construye el despliegue, y entregarla tal cual seria
# desplegar en modo depuracion. Antes de servir en produccion, cambia:
#
#   APP_ENV=production
#   APP_DEBUG=false          <- CRITICO. Con true, un error 500 renderiza la
#                               pagina de Ignition con traza completa, codigo
#                               fuente y VOLCADO DE VARIABLES DE ENTORNO, lo
#                               que incluiria APP_KEY y el secreto de Reverb.
#   LOG_LEVEL=warning
#   SESSION_ENCRYPT=true
#   SESSION_SECURE_COOKIE=true
#   BROADCAST_CONNECTION=reverb   <- nunca log ni null: desactivan la
#                                    autorizacion de canal (F-07).
#   REVERB_APP_SECRET=<un secreto real, no el de esta plantilla>
#
# Y en el servidor, ademas del despliegue de la aplicacion:
#
#   * * * * * cd /ruta/al/proyecto && php artisan schedule:run >> /dev/null 2>&1
#
#   Sin esa entrada de cron, la retencion de 30 dias (D-12) NO SE EJECUTA y la
#   pagina publica de privacidad estaria prometiendo algo falso (F-13).
#   Comprueba tras desplegar que `php artisan schedule:list` NO esta vacio.
#
#   Con Docker, ese cron lo cubre el servicio `scheduler` de docker-compose.yml
#   (bucle que invoca `schedule:run` cada 60 s). Sin Docker, la entrada de
#   crontab de arriba es OBLIGATORIA. Procedimiento completo y comprobaciones:
#   OPERATIONS.md 7 y DEPLOYMENT.md 5.
#
# Cabeceras que la aplicacion no puede emitir por si sola y debe poner el
# proxy con TLS por delante (hallazgo F-11):
#
#   Strict-Transport-Security: max-age=31536000; includeSubDomains
#
#   Ya preparada y COMENTADA en docker/nginx/encuestalive.conf. Activarla solo
#   cuando el certificado este confirmado: enviar HSTS con un certificado roto
#   deja el dominio inaccesible durante todo el `max-age`.
#
# La guia completa, con orden de arranque, migraciones, reversion y lista de
# comprobacion previa a produccion, esta en:
#   /software-factory/deliverables/encuestalive/DEPLOYMENT.md
#   /software-factory/deliverables/encuestalive/INSTALLATION.md  (ruta local)
#   /software-factory/deliverables/encuestalive/OPERATIONS.md    (respaldos)
